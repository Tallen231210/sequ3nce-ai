# Convex - Get this from your Convex dashboard after running `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Clerk - Get these from your Clerk dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Admin - Password for accessing /admin pages
ADMIN_PASSWORD=your-secure-admin-password

# Audio Processor - WebSocket URL for live audio streaming (optional, only needed for live streaming feature)
NEXT_PUBLIC_AUDIO_PROCESSOR_URL=wss://your-audio-processor.railway.app

# ============================================
# Setter Data — GoHighLevel Marketplace App
# ============================================
# Required to enable the /dashboard/setter-data feature. Set up:
#   1. Register a private Marketplace App at https://marketplace.gohighlevel.com/
#   2. Configure the OAuth redirect URL: https://sequ3nce.ai/api/setter-data-marketplace/oauth/callback
#   3. Configure the webhook URL: https://<convex-prod>.convex.site/webhooks/setter-data-marketplace
#   4. Set scopes: contacts.readonly, conversations.readonly,
#      conversations/message.readonly, users.readonly, locations.readonly
#   5. Subscribe to events: Contact.Create, Contact.Update, OutboundMessage,
#      InboundMessage, INSTALL, UNINSTALL
#   6. Capture the client ID, client secret, and Ed25519 webhook public key

# Public (Vercel + browser-side install button)
NEXT_PUBLIC_GHL_CLIENT_ID=ghl_app_client_id
NEXT_PUBLIC_GHL_REDIRECT_URI=https://sequ3nce.ai/api/setter-data-marketplace/oauth/callback

# Server-only (set in Convex dashboard, NOT Vercel)
# GHL_CLIENT_ID=...
# GHL_CLIENT_SECRET=...
# GHL_WEBHOOK_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...PEM contents...\n-----END PUBLIC KEY-----
