{
  "name": "sequ3nce-personal",
  "productName": "Sequ3nce Personal",
  "version": "1.17.3",
  "description": "Sequ3nce Personal — call recording, verified stats, and career tools for high-ticket closers",
  "main": ".webpack/main",
  "scripts": {
    "start": "npm run build:native && electron-forge start",
    "package": "npm run build:native && electron-forge package",
    "make": "npm run build:native && electron-forge make",
    "publish": "npm run build:native && electron-forge publish && ./scripts/upload-update-manifest.sh",
    "publish:draft": "npm run build:native && electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "build:native": "bash scripts/build-native.sh",
    "build:mac": "npm run build:native && electron-forge make --platform darwin",
    "build:linux": "electron-forge make --platform linux",
    "build:all": "npm run build:native && electron-forge make --platform darwin,linux",
    "make:win:nsis": "electron-forge package --platform=win32 --arch=x64 && electron-builder --prepackaged \"out/Sequ3nce Personal-win32-x64\" --win"
  },
  "keywords": [],
  "author": {
    "name": "Tyler Allen",
    "email": "tylerallen@Tylers-MacBook-Pro.local"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-webpack": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/notarize": "^3.1.1",
    "@electron/osx-sign": "^2.3.0",
    "@playwright/test": "^1.58.2",
    "@timfish/forge-externals-plugin": "^0.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "autoprefixer": "^10.4.22",
    "css-loader": "^6.11.0",
    "electron": "39.2.6",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "fork-ts-checker-webpack-plugin": "^7.3.0",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "style-loader": "^3.3.4",
    "tailwindcss": "^4.1.17",
    "ts-loader": "^9.5.4",
    "typescript": "~4.5.4"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.58.1",
    "@daily-co/daily-js": "^0.89.1",
    "@daily-co/daily-react": "^0.25.0",
    "@sentry/electron": "^7.13.0",
    "@tailwindcss/postcss": "^4.1.17",
    "convex": "^1.31.0",
    "electron-audio-loopback": "^1.0.6",
    "electron-updater": "^6.6.2",
    "koffi": "^2.15.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "^5.5.6",
    "uiohook-napi": "^1.5.5",
    "uuid": "^13.0.0",
    "ws": "^8.18.3"
  },
  "build": {
    "appId": "com.sequ3nce.personal",
    "productName": "Sequ3nce Personal",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Sequ3nce-Personal-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "generateUpdatesFilesForAllChannels": false,
    "publish": {
      "provider": "generic",
      "url": "https://www.sequ3nce.ai/api/updates/personal"
    }
  }
}
